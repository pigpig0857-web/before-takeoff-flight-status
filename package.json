{
  "name": "flight-status",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "flights:update": "tsx scripts/update-flight-schedules.ts",
    "flights:refresh": "tsx scripts/refresh-flight-schedules.ts",
    "flights:verify-auto": "node --use-system-ca --import tsx scripts/automatic-verification/run.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "inspect:sources": "tsx scripts/inspect-sources.ts",
    "sync:destinations": "tsx scripts/sync-destinations.ts",
    "crawler:trial": "tsx scripts/crawler/trial-ci-timetable.ts",
    "crawler:ci-network": "tsx scripts/crawler/trial-ci-network.ts",
    "crawler:ci-stability": "tsx scripts/crawler/check-ci-stability.ts",
    "crawler:eva-replay": "tsx scripts/crawler/analyze-eva-schedule.ts",
    "crawler:eva-form": "node scripts/crawler/fetch-eva-form-node.mjs",
    "crawler:eva-http-stability": "node scripts/crawler/analyze-eva-http-stability.mjs",
    "crawler:eva-expansion": "node scripts/crawler/analyze-eva-expansion.mjs",
    "crawler:eva-coverage": "node scripts/crawler/run-eva-coverage.mjs",
    "crawler:eva-coverage-audit": "node scripts/crawler/audit-eva-coverage.mjs",
    "crawler:eva-phase2": "node scripts/crawler/analyze-eva-phase2.mjs",
    "crawler:eva-yearend": "node scripts/crawler/collect-eva-yearend.mjs",
    "crawler:eva-yearend-audit": "tsx scripts/crawler/audit-eva-yearend.ts",
    "crawler:eva-yearend-details": "node scripts/crawler/sample-eva-yearend-details.mjs",
    "crawler:eva-yearend-enrich": "tsx scripts/crawler/enrich-eva-yearend.ts",
    "crawler:eva-yearend-import-details": "tsx scripts/crawler/import-eva-details.ts",
    "crawler:eva-yearend-import": "tsx scripts/crawler/import-eva-yearend.ts",
    "crawler:peach": "node scripts/crawler/collect-peach.mjs",
    "crawler:peach-import": "tsx scripts/crawler/import-peach-yearend.ts",
    "crawler:peach-smoke": "node scripts/crawler/smoke-peach-integration.mjs",
    "crawler:peach-guides": "node scripts/crawler/collect-peach-airport-guides.mjs",
    "crawler:peach-import-guides": "node scripts/crawler/import-peach-airport-guides.mjs",
    "crawler:peach-import-checks": "node scripts/crawler/import-peach-booking-checks.mjs",
    "crawler:peach-import-full-details": "node scripts/crawler/import-peach-full-details.mjs",
    "crawler:audit-flight-evidence": "node scripts/crawler/audit-current-flight-evidence.mjs",
    "crawler:eva-yearend-smoke": "node scripts/crawler/smoke-eva-yearend.mjs",
    "crawler:source-stability": "tsx scripts/crawler/analyze-source-stability.ts",
    "crawler:trip-trial": "tsx scripts/crawler/trial-trip-page.ts",
    "crawler:trip-stability": "tsx scripts/crawler/analyze-trip-stability.ts",
    "crawler:trip-direct": "tsx scripts/crawler/analyze-trip-direct.ts",
    "crawler:inventory": "tsx scripts/crawler/aggregate-flight-samples.ts",
    "crawler:import": "tsx scripts/crawler/import-collected.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"docs/*.md\" package.json tsconfig.json next.config.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "setup:data": "node scripts/setup-public-data.mjs",
    "postinstall": "node scripts/setup-public-data.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9"
  },
  "description": "桃園與高雄航班來回查詢、搭機指南及 AI 航班助理（不含私人資料）"
}
