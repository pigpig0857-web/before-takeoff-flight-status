# official: official feeds only. demo: explicit synthetic data for development.
# An official outage NEVER silently falls back to demo data.
FLIGHT_DATA_MODE=official

# Server-side Gemini access via Vertex AI. Never expose credentials to the browser.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_VERTEX_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_API_VERSION=v1
